# ===========================================================================
#  Deployment Checklist — environment
#  Copy to .env.local and fill in. Every value is validated at boot by
#  src/lib/config/env.ts — a missing or malformed value fails the build, not
#  the first password reset at 2am.
# ===========================================================================

# ── Database ───────────────────────────────────────────────────────────────
# MUST be a replica set. Prisma interactive transactions require one, and the
# entire write path depends on them.
#
# Option A — zero install, local dev (recommended here; no Docker needed):
#     npm run dev:db        starts a single-node replica set and prints the URL
#     DATABASE_URL="mongodb://127.0.0.1:27017/deployment_checklist?replicaSet=rs0&directConnection=true"
#
# Option B — MongoDB Atlas free tier (M0 is already a replica set):
#     DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/deployment_checklist?retryWrites=true&w=majority"
#
# Option C — Docker, if you have it:
#     docker compose up -d   (see docker-compose.yml)
DATABASE_URL="mongodb://127.0.0.1:27017/deployment_checklist?replicaSet=rs0&directConnection=true"

# ── Application ────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Auth.js ────────────────────────────────────────────────────────────────
# Generate:  openssl rand -base64 32     (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ── Secret encryption (SMTP password, API keys at rest) ────────────────────
# Exactly 32 bytes, base64-encoded. Generate the same way as AUTH_SECRET.
# Losing this makes stored secrets unrecoverable — back it up with your secrets manager.
SECRET_ENCRYPTION_KEY=""

# ── Cron / background jobs ─────────────────────────────────────────────────
# Guards /api/cron/*. Generate the same way as AUTH_SECRET.
CRON_SECRET=""

# ── Email ──────────────────────────────────────────────────────────────────
# Master switch for the whole email feature, owned by the deployment.
#
# false → outbox rows are still written inside their transactions (nothing is
#         lost, the history stays intact) and the worker closes them out as
#         "Skipped — email disabled" without constructing a transport. No SMTP
#         credentials are required and boot does not fail for missing ones.
#         An admin CANNOT re-enable email from the UI while this is false.
# true  → normal delivery (the default). Production additionally refuses
#         EMAIL_PROVIDER=console|noop while this is true, because invitations
#         would silently never arrive and nobody could report it.
#
# There is no email provider yet, so this is the switch. Turning it back on once
# there is one is the entire migration — no code change.
#
# In local development leave it true and keep EMAIL_PROVIDER=console: links are
# printed to the terminal, which is how you click an invite or reset in dev.
EMAIL_ENABLED="true"

# Who wins when the database Setting row and these variables disagree.
#   settings — admin UI wins per field, env fills the gaps (default)
#   env      — the Setting row is ignored entirely for email transport
#
# Use "env" while there is no provider: Setting.emailProvider defaults to
# "gmail" in the Prisma schema, so a seeded row otherwise outranks
# EMAIL_PROVIDER below and the worker starts dialling Gmail with no credentials.
EMAIL_CONFIG_SOURCE="env"

# console = print to the terminal, never send. The default for development so a
# fresh clone works with no Gmail account and nobody emails a real person from
# seeded data. Ignored entirely when EMAIL_ENABLED="false".
#   console | gmail | smtp | resend | ses | noop
EMAIL_PROVIDER="console"

# Gmail SMTP (EMAIL_PROVIDER=gmail)
#   - Requires a 16-char App Password, NOT the account password (2FA must be on):
#     https://myaccount.google.com/apppasswords
#   - Gmail rewrites the From header to the authenticated account unless the
#     address is a verified "Send mail as" alias — the provider refuses to start
#     on a mismatch rather than silently sending as the wrong sender.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="Deployment Checklist"
# Comma-separated verified Gmail aliases, if EMAIL_FROM_ADDRESS != SMTP_USERNAME
GMAIL_VERIFIED_ALIASES=""

# Resend / SES (EMAIL_PROVIDER=resend|ses)
EMAIL_API_KEY=""
AWS_REGION=""

# ── File storage ───────────────────────────────────────────────────────────
#   local | s3 | azure | gcs | memory
STORAGE_PROVIDER="local"
# Must sit OUTSIDE the web root. Relative paths resolve from the project root.
STORAGE_LOCAL_ROOT="./storage"
STORAGE_PREFIX="uploads"
MAX_UPLOAD_MB="25"

# S3 / S3-compatible (MinIO, R2, Wasabi, Spaces)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Rate limiting ──────────────────────────────────────────────────────────
# Leave empty to use the Mongo-backed limiter. In-process counters are NOT an
# option: every serverless instance would enforce the limit independently.
REDIS_URL=""

# ── Search ─────────────────────────────────────────────────────────────────
#   atlas = $search aggregation (Atlas only) | regex = anchored regex fallback
SEARCH_BACKEND="regex"

# ── Seed ───────────────────────────────────────────────────────────────────
SEED_ORG_NAME="Acme Engineering"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Platform Admin"
SEED_ADMIN_PASSWORD="ChangeMeImmediately!2026"
# Refuses to seed against a production database unless this is explicitly true.
SEED_ALLOW_PRODUCTION="false"

# ── Observability (optional) ───────────────────────────────────────────────
LOG_LEVEL="info"
SENTRY_DSN=""
